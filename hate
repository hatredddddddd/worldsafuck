local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ByteNetReliable = ReplicatedStorage:WaitForChild("ByteNetReliable")

local KEY_X = 0x58 -- offset for "X"

local running = false

while true do
    task.wait()

    if isrbxactive() and iskeypressed(KEY_X) then
        keyrelease(KEY_X)

        running = not running

        if running then
            print("Started")
        else
            print("Stopped")
        end
    end

    if running then
        ByteNetReliable:FireServer(buffer.fromstring("\?"))
        task.wait(0.1)
    end
end
