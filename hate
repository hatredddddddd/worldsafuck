local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ByteNetReliable = ReplicatedStorage:WaitForChild("ByteNetReliable")

local KEY_H = 0x48 -- offset for "H"

local running = false

while true do
    task.wait()

    if isrbxactive() and iskeypressed(KEY_H) then
        keyrelease(KEY_H)

        running = not running

        if running then
            print("Started")
        else
            print("Stopped")
        end
    end

    if running then
        ByteNetReliable:FireServer(buffer.fromstring("\53"))
        task.wait(0.1)
    end
end
